BEGIN TRANSACTION;
CREATE TABLE "academy_academyalert" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "alert_type" varchar(40) NOT NULL, "title" varchar(255) NOT NULL, "message" text NOT NULL, "severity" varchar(20) NOT NULL, "link" varchar(255) NOT NULL, "is_dismissed" bool NOT NULL, "created_at" datetime NOT NULL);
CREATE TABLE "academy_academysettings" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "academy_name" varchar(200) NOT NULL, "tagline" varchar(255) NOT NULL, "teacher_name" varchar(150) NOT NULL, "attendance_threshold" real NOT NULL, "consecutive_absence_threshold" integer unsigned NOT NULL CHECK ("consecutive_absence_threshold" >= 0), "currency_symbol" varchar(10) NOT NULL, "date_format" varchar(30) NOT NULL, "enable_fees" bool NOT NULL, "enable_late_status" bool NOT NULL, "default_class_duration" integer unsigned NOT NULL CHECK ("default_class_duration" >= 0), "updated_at" datetime NOT NULL);
CREATE TABLE "academy_attendance" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "status" varchar(20) NOT NULL, "remarks" varchar(255) NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL, "marked_by_id" integer NULL REFERENCES "auth_user" ("id") DEFERRABLE INITIALLY DEFERRED, "session_id" bigint NOT NULL REFERENCES "academy_classsession" ("id") DEFERRABLE INITIALLY DEFERRED, "student_id" bigint NOT NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED, CONSTRAINT "unique_session_student_attendance" UNIQUE ("session_id", "student_id"));
CREATE TABLE "academy_attendanceauditlog" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "old_status" varchar(20) NOT NULL, "new_status" varchar(20) NOT NULL, "changed_at" datetime NOT NULL, "reason" text NOT NULL, "changed_by_id" integer NULL REFERENCES "auth_user" ("id") DEFERRABLE INITIALLY DEFERRED, "session_id" bigint NOT NULL REFERENCES "academy_classsession" ("id") DEFERRABLE INITIALLY DEFERRED, "student_id" bigint NOT NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "academy_batch" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "batch_id" varchar(40) NOT NULL UNIQUE, "name" varchar(150) NOT NULL, "description" text NOT NULL, "level" varchar(30) NOT NULL, "teacher_name" varchar(150) NOT NULL, "regular_day" varchar(20) NOT NULL, "start_time" time NOT NULL, "end_time" time NOT NULL, "start_date" date NOT NULL, "end_date" date NULL, "is_active" bool NOT NULL, "notes" text NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL);
CREATE TABLE "academy_batchenrollment" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "enrolled_date" date NOT NULL, "left_date" date NULL, "is_active" bool NOT NULL, "batch_id" bigint NOT NULL REFERENCES "academy_batch" ("id") DEFERRABLE INITIALLY DEFERRED, "student_id" bigint NOT NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED, CONSTRAINT "unique_student_batch_enrollment_date" UNIQUE ("student_id", "batch_id", "enrolled_date"));
CREATE TABLE "academy_classsession" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "date" date NOT NULL, "start_time" time NOT NULL, "end_time" time NOT NULL, "status" varchar(20) NOT NULL, "cancellation_reason" text NOT NULL, "lesson_topic" varchar(255) NOT NULL, "notes" text NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL, "batch_id" bigint NOT NULL REFERENCES "academy_batch" ("id") DEFERRABLE INITIALLY DEFERRED, CONSTRAINT "unique_batch_session_time" UNIQUE ("batch_id", "date", "start_time"));
CREATE TABLE "academy_composition" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "title" varchar(200) NOT NULL, "category" varchar(40) NOT NULL, "difficulty" varchar(30) NOT NULL, "bol_notation" text NOT NULL, "recommended_tempo" varchar(100) NOT NULL, "practice_instructions" text NOT NULL, "reference_link" varchar(200) NOT NULL, "notes" text NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL, "taal_id" bigint NOT NULL REFERENCES "academy_taal" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "academy_examinationrecord" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "exam_name" varchar(255) NOT NULL, "exam_board" varchar(255) NOT NULL, "exam_date" date NOT NULL, "theory_progress" varchar(255) NOT NULL, "practical_progress" varchar(255) NOT NULL, "mock_result" varchar(100) NOT NULL, "teacher_remarks" text NOT NULL, "created_at" datetime NOT NULL, "student_id" bigint NOT NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "academy_feeplan" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "name" varchar(150) NOT NULL, "amount" decimal NOT NULL, "billing_frequency" varchar(30) NOT NULL, "description" text NOT NULL, "is_active" bool NOT NULL);
CREATE TABLE "academy_lesson" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "date" date NOT NULL, "topic" varchar(255) NOT NULL, "composition_type" varchar(100) NOT NULL, "bol_notation" text NOT NULL, "tempo_bpm" varchar(60) NOT NULL, "summary" text NOT NULL, "homework" text NOT NULL, "next_lesson_goal" text NOT NULL, "teacher_feedback" text NOT NULL, "notes" text NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL, "batch_id" bigint NOT NULL REFERENCES "academy_batch" ("id") DEFERRABLE INITIALLY DEFERRED, "session_id" bigint NULL REFERENCES "academy_classsession" ("id") DEFERRABLE INITIALLY DEFERRED, "taal_id" bigint NULL REFERENCES "academy_taal" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "academy_paymentrecord" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "amount_due" decimal NOT NULL, "amount_paid" decimal NOT NULL, "billing_period" varchar(100) NOT NULL, "due_date" date NULL, "payment_date" date NULL, "payment_method" varchar(30) NOT NULL, "receipt_number" varchar(100) NOT NULL, "notes" text NOT NULL, "created_at" datetime NOT NULL, "fee_plan_id" bigint NULL REFERENCES "academy_feeplan" ("id") DEFERRABLE INITIALLY DEFERRED, "student_id" bigint NOT NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "academy_performancerecord" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "event_name" varchar(255) NOT NULL, "event_date" date NOT NULL, "venue" varchar(255) NOT NULL, "composition_performed" text NOT NULL, "taal" varchar(100) NOT NULL, "teacher_feedback" text NOT NULL, "recording_url" varchar(200) NOT NULL, "notes" text NOT NULL, "created_at" datetime NOT NULL, "batch_id" bigint NULL REFERENCES "academy_batch" ("id") DEFERRABLE INITIALLY DEFERRED, "student_id" bigint NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "academy_practiceassignment" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "title" varchar(255) NOT NULL, "description" text NOT NULL, "composition_type" varchar(100) NOT NULL, "target_tempo" varchar(100) NOT NULL, "recommended_practice_duration" varchar(100) NOT NULL, "assigned_date" date NOT NULL, "due_date" date NOT NULL, "teacher_instructions" text NOT NULL, "status" varchar(30) NOT NULL, "feedback" text NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL, "batch_id" bigint NULL REFERENCES "academy_batch" ("id") DEFERRABLE INITIALLY DEFERRED, "related_lesson_id" bigint NULL REFERENCES "academy_lesson" ("id") DEFERRABLE INITIALLY DEFERRED, "student_id" bigint NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED, "taal_id" bigint NULL REFERENCES "academy_taal" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "academy_student" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "student_id" varchar(40) NOT NULL UNIQUE, "first_name" varchar(100) NOT NULL, "last_name" varchar(100) NOT NULL, "phone" varchar(25) NOT NULL, "email" varchar(254) NOT NULL, "guardian_name" varchar(150) NOT NULL, "guardian_phone" varchar(25) NOT NULL, "date_of_birth" date NULL, "enrollment_date" date NOT NULL, "level" varchar(30) NOT NULL, "status" varchar(30) NOT NULL, "notes" text NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL);
CREATE TABLE "academy_studentprogress" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "date" date NOT NULL, "current_level" varchar(50) NOT NULL, "taals_studied" text NOT NULL, "compositions_studied" text NOT NULL, "topics_completed" text NOT NULL, "topics_needing_revision" text NOT NULL, "tempo_targets" varchar(150) NOT NULL, "feedback" text NOT NULL, "next_goal" text NOT NULL, "created_at" datetime NOT NULL, "student_id" bigint NOT NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "academy_taal" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "name" varchar(100) NOT NULL UNIQUE, "matras" integer unsigned NOT NULL CHECK ("matras" >= 0), "vibhag_structure" varchar(100) NOT NULL, "tali_khali_info" varchar(255) NOT NULL, "theka_notation" text NOT NULL, "level" varchar(30) NOT NULL, "notes" text NOT NULL, "reference_url" varchar(200) NOT NULL);
CREATE TABLE "auth_group" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "name" varchar(150) NOT NULL UNIQUE);
CREATE TABLE "auth_group_permissions" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "group_id" integer NOT NULL REFERENCES "auth_group" ("id") DEFERRABLE INITIALLY DEFERRED, "permission_id" integer NOT NULL REFERENCES "auth_permission" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "auth_permission" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "content_type_id" integer NOT NULL REFERENCES "django_content_type" ("id") DEFERRABLE INITIALLY DEFERRED, "codename" varchar(100) NOT NULL, "name" varchar(255) NOT NULL);
