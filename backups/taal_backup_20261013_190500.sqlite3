BEGIN TRANSACTION;
CREATE TABLE "academy_academyalert" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "alert_type" varchar(40) NOT NULL, "title" varchar(255) NOT NULL, "message" text NOT NULL, "severity" varchar(20) NOT NULL, "link" varchar(255) NOT NULL, "is_dismissed" bool NOT NULL, "created_at" datetime NOT NULL);
INSERT INTO "academy_academyalert" VALUES(1,'attendance_low','Low Attendance: Pooja Menon (0.0%)','Pooja Menon has attended 0 of 1 eligible conducted classes (0.0%), falling below your threshold of 75.0%.','warning','/students/2/',0,'2026-10-13 19:05:00.211565');
CREATE TABLE "academy_academysettings" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "tagline" varchar(255) NOT NULL, "teacher_name" varchar(150) NOT NULL, "attendance_threshold" real NOT NULL, "consecutive_absence_threshold" integer unsigned NOT NULL CHECK ("consecutive_absence_threshold" >= 0), "currency_symbol" varchar(10) NOT NULL, "date_format" varchar(30) NOT NULL, "enable_fees" bool NOT NULL, "enable_late_status" bool NOT NULL, "default_class_duration" integer unsigned NOT NULL CHECK ("default_class_duration" >= 0), "updated_at" datetime NOT NULL, "address" text NOT NULL, "email" varchar(254) NOT NULL, "phone" varchar(25) NOT NULL, "whatsapp_number" varchar(25) NOT NULL, "academy_name" varchar(200) NOT NULL);
INSERT INTO "academy_academysettings" VALUES(1,'Every Beat. Every Lesson. Every Milestone.','Guru Ji',75.0,3,'₹','YYYY-MM-DD',1,0,60,'2026-10-13 19:05:00.169548','Radhhanand Sangeet Vidyalaya, India','contact@radhhanand.org','+91 98765 43210','+91 98765 43210','Radhhanand Sangeet Vidyalaya');
CREATE TABLE "academy_attendance" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "status" varchar(20) NOT NULL, "remarks" varchar(255) NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL, "marked_by_id" integer NULL REFERENCES "auth_user" ("id") DEFERRABLE INITIALLY DEFERRED, "session_id" bigint NOT NULL REFERENCES "academy_classsession" ("id") DEFERRABLE INITIALLY DEFERRED, "student_id" bigint NOT NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED, CONSTRAINT "unique_session_student_attendance" UNIQUE ("session_id", "student_id"));
INSERT INTO "academy_attendance" VALUES(1,'present','Excellent posture','2026-10-13 19:05:00.174461','2026-10-13 19:05:00.174475',1,1,1);
INSERT INTO "academy_attendance" VALUES(2,'leave','Informed beforehand by guardian','2026-10-13 19:05:00.175529','2026-10-13 19:05:00.199928',1,1,2);
CREATE TABLE "academy_attendanceauditlog" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "old_status" varchar(20) NOT NULL, "new_status" varchar(20) NOT NULL, "changed_at" datetime NOT NULL, "reason" text NOT NULL, "changed_by_id" integer NULL REFERENCES "auth_user" ("id") DEFERRABLE INITIALLY DEFERRED, "session_id" bigint NOT NULL REFERENCES "academy_classsession" ("id") DEFERRABLE INITIALLY DEFERRED, "student_id" bigint NOT NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED);
INSERT INTO "academy_attendanceauditlog" VALUES(1,'absent','leave','2026-10-13 19:05:00.199722','Parent notified teacher earlier',1,1,2);
CREATE TABLE "academy_batch" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "batch_id" varchar(40) NOT NULL UNIQUE, "name" varchar(150) NOT NULL, "description" text NOT NULL, "level" varchar(30) NOT NULL, "teacher_name" varchar(150) NOT NULL, "regular_day" varchar(20) NOT NULL, "start_time" time NOT NULL, "end_time" time NOT NULL, "start_date" date NOT NULL, "end_date" date NULL, "is_active" bool NOT NULL, "notes" text NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL, "capacity" integer unsigned NOT NULL CHECK ("capacity" >= 0), "course" varchar(100) NOT NULL, "is_archived" bool NOT NULL, "monthly_fee" decimal NOT NULL);
INSERT INTO "academy_batch" VALUES(1,'BAT-ACC-01','Acceptance Verification Batch','','beginner','','Saturday','10:00:00','11:00:00','2026-09-13',NULL,1,'','2026-10-13 19:05:00.149028','2026-10-13 19:05:00.149037',15,'Tabla',0,0);
CREATE TABLE "academy_batchenrollment" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "enrolled_date" date NOT NULL, "left_date" date NULL, "is_active" bool NOT NULL, "batch_id" bigint NOT NULL REFERENCES "academy_batch" ("id") DEFERRABLE INITIALLY DEFERRED, "student_id" bigint NOT NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED, CONSTRAINT "unique_student_batch_enrollment_date" UNIQUE ("student_id", "batch_id", "enrolled_date"));
INSERT INTO "academy_batchenrollment" VALUES(1,'2026-09-13',NULL,1,1,1);
INSERT INTO "academy_batchenrollment" VALUES(2,'2026-09-13',NULL,1,1,2);
CREATE TABLE "academy_batchrecurringschedule" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "day_of_week" integer NOT NULL, "start_time" time NOT NULL, "end_time" time NOT NULL, "duration_minutes" integer unsigned NOT NULL CHECK ("duration_minutes" >= 0), "is_active" bool NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL, "batch_id" bigint NOT NULL REFERENCES "academy_batch" ("id") DEFERRABLE INITIALLY DEFERRED, CONSTRAINT "unique_batch_recurring_slot" UNIQUE ("batch_id", "day_of_week", "start_time"));
CREATE TABLE "academy_chatbotverificationcode" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "phone_number" varchar(25) NOT NULL, "code" varchar(10) NOT NULL, "is_verified" bool NOT NULL, "created_at" datetime NOT NULL, "expires_at" datetime NOT NULL, "attempts" integer unsigned NOT NULL CHECK ("attempts" >= 0));
CREATE TABLE "academy_classsession" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "date" date NOT NULL, "start_time" time NOT NULL, "end_time" time NOT NULL, "status" varchar(20) NOT NULL, "cancellation_reason" text NOT NULL, "lesson_topic" varchar(255) NOT NULL, "notes" text NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL, "batch_id" bigint NOT NULL REFERENCES "academy_batch" ("id") DEFERRABLE INITIALLY DEFERRED, "is_rescheduled" bool NOT NULL, "original_date" date NULL, "original_start_time" time NULL, "reschedule_reason" text NOT NULL, "schedule_rule_id" bigint NULL REFERENCES "academy_batchrecurringschedule" ("id") DEFERRABLE INITIALLY DEFERRED, CONSTRAINT "unique_batch_session_time" UNIQUE ("batch_id", "date", "start_time"));
INSERT INTO "academy_classsession" VALUES(1,'2026-10-06','10:00:00','11:00:00','conducted','','Introduction to Teentaal Theka','','2026-10-13 19:05:00.152624','2026-10-13 19:05:00.152880',1,0,NULL,NULL,'',NULL);
CREATE TABLE "academy_composition" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "title" varchar(200) NOT NULL, "category" varchar(40) NOT NULL, "difficulty" varchar(30) NOT NULL, "bol_notation" text NOT NULL, "recommended_tempo" varchar(100) NOT NULL, "practice_instructions" text NOT NULL, "reference_link" varchar(200) NOT NULL, "notes" text NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL, "taal_id" bigint NOT NULL REFERENCES "academy_taal" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "academy_examinationrecord" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "exam_name" varchar(255) NOT NULL, "exam_board" varchar(255) NOT NULL, "exam_date" date NOT NULL, "theory_progress" varchar(255) NOT NULL, "practical_progress" varchar(255) NOT NULL, "mock_result" varchar(100) NOT NULL, "teacher_remarks" text NOT NULL, "created_at" datetime NOT NULL, "student_id" bigint NOT NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "academy_feeplan" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "name" varchar(150) NOT NULL, "amount" decimal NOT NULL, "billing_frequency" varchar(30) NOT NULL, "description" text NOT NULL, "is_active" bool NOT NULL);
CREATE TABLE "academy_lesson" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "date" date NOT NULL, "topic" varchar(255) NOT NULL, "composition_type" varchar(100) NOT NULL, "bol_notation" text NOT NULL, "tempo_bpm" varchar(60) NOT NULL, "summary" text NOT NULL, "homework" text NOT NULL, "next_lesson_goal" text NOT NULL, "teacher_feedback" text NOT NULL, "notes" text NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL, "batch_id" bigint NOT NULL REFERENCES "academy_batch" ("id") DEFERRABLE INITIALLY DEFERRED, "session_id" bigint NULL REFERENCES "academy_classsession" ("id") DEFERRABLE INITIALLY DEFERRED, "taal_id" bigint NULL REFERENCES "academy_taal" ("id") DEFERRABLE INITIALLY DEFERRED);
INSERT INTO "academy_lesson" VALUES(1,'2026-10-06','Teentaal Theka & Dayna balance','','Dha Dhin Dhin Dha','','Focused on clear Dayna resonance','Practice Theka 20 minutes daily','','','','2026-10-13 19:05:00.285873','2026-10-13 19:05:00.285885',1,1,1);
CREATE TABLE "academy_paymentrecord" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "amount_due" decimal NOT NULL, "amount_paid" decimal NOT NULL, "billing_period" varchar(100) NOT NULL, "due_date" date NULL, "payment_date" date NULL, "payment_method" varchar(30) NOT NULL, "notes" text NOT NULL, "created_at" datetime NOT NULL, "fee_plan_id" bigint NULL REFERENCES "academy_feeplan" ("id") DEFERRABLE INITIALLY DEFERRED, "student_id" bigint NOT NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED, "fee_month" smallint unsigned NULL CHECK ("fee_month" >= 0), "fee_year" smallint unsigned NULL CHECK ("fee_year" >= 0), "idempotency_key" varchar(64) NOT NULL, "is_reversed" bool NOT NULL, "reversal_reason" text NOT NULL, "transaction_reference" varchar(150) NOT NULL, "updated_at" datetime NOT NULL, "receipt_number" varchar(100) NOT NULL);
CREATE TABLE "academy_performancerecord" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "event_name" varchar(255) NOT NULL, "event_date" date NOT NULL, "venue" varchar(255) NOT NULL, "composition_performed" text NOT NULL, "taal" varchar(100) NOT NULL, "teacher_feedback" text NOT NULL, "recording_url" varchar(200) NOT NULL, "notes" text NOT NULL, "created_at" datetime NOT NULL, "batch_id" bigint NULL REFERENCES "academy_batch" ("id") DEFERRABLE INITIALLY DEFERRED, "student_id" bigint NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "academy_practiceassignment" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "title" varchar(255) NOT NULL, "description" text NOT NULL, "composition_type" varchar(100) NOT NULL, "target_tempo" varchar(100) NOT NULL, "recommended_practice_duration" varchar(100) NOT NULL, "assigned_date" date NOT NULL, "due_date" date NOT NULL, "teacher_instructions" text NOT NULL, "status" varchar(30) NOT NULL, "feedback" text NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL, "batch_id" bigint NULL REFERENCES "academy_batch" ("id") DEFERRABLE INITIALLY DEFERRED, "related_lesson_id" bigint NULL REFERENCES "academy_lesson" ("id") DEFERRABLE INITIALLY DEFERRED, "student_id" bigint NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED, "taal_id" bigint NULL REFERENCES "academy_taal" ("id") DEFERRABLE INITIALLY DEFERRED);
INSERT INTO "academy_practiceassignment" VALUES(1,'Daily Theka Riyaz','Steady 60 BPM tempo practice','','','','2026-10-14','2026-10-20','','assigned','','2026-10-13 19:05:00.288144','2026-10-13 19:05:00.288158',1,1,1,NULL);
CREATE TABLE "academy_student" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "student_id" varchar(40) NOT NULL UNIQUE, "first_name" varchar(100) NOT NULL, "last_name" varchar(100) NOT NULL, "phone" varchar(25) NOT NULL, "email" varchar(254) NOT NULL, "guardian_name" varchar(150) NOT NULL, "guardian_phone" varchar(25) NOT NULL, "date_of_birth" date NULL, "enrollment_date" date NOT NULL, "level" varchar(30) NOT NULL, "status" varchar(30) NOT NULL, "notes" text NOT NULL, "created_at" datetime NOT NULL, "updated_at" datetime NOT NULL, "address" text NOT NULL, "guardian_whatsapp" varchar(25) NOT NULL, "is_archived" bool NOT NULL, "monthly_fee" decimal NOT NULL);
