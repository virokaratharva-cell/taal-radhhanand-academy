CREATE TABLE "academy_studentprogress" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "date" date NOT NULL, "current_level" varchar(50) NOT NULL, "taals_studied" text NOT NULL, "compositions_studied" text NOT NULL, "topics_completed" text NOT NULL, "topics_needing_revision" text NOT NULL, "tempo_targets" varchar(150) NOT NULL, "feedback" text NOT NULL, "next_goal" text NOT NULL, "created_at" datetime NOT NULL, "student_id" bigint NOT NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "academy_taal" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "name" varchar(100) NOT NULL UNIQUE, "matras" integer unsigned NOT NULL CHECK ("matras" >= 0), "vibhag_structure" varchar(100) NOT NULL, "tali_khali_info" varchar(255) NOT NULL, "theka_notation" text NOT NULL, "level" varchar(30) NOT NULL, "notes" text NOT NULL, "reference_url" varchar(200) NOT NULL);
INSERT INTO "academy_taal" VALUES(1,'Teentaal',16,'4+4+4+4','1,5,13','Theka','beginner','','');
CREATE TABLE "academy_whatsappmessagelog" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "recipient_phone" varchar(25) NOT NULL, "recipient_name" varchar(150) NOT NULL, "message_type" varchar(30) NOT NULL, "message_text" text NOT NULL, "provider_message_id" varchar(150) NOT NULL, "status" varchar(30) NOT NULL, "error_details" text NOT NULL, "created_at" datetime NOT NULL, "payment_id" bigint NULL REFERENCES "academy_paymentrecord" ("id") DEFERRABLE INITIALLY DEFERRED, "session_id" bigint NULL REFERENCES "academy_classsession" ("id") DEFERRABLE INITIALLY DEFERRED, "student_id" bigint NULL REFERENCES "academy_student" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "auth_group" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "name" varchar(150) NOT NULL UNIQUE);
CREATE TABLE "auth_group_permissions" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "group_id" integer NOT NULL REFERENCES "auth_group" ("id") DEFERRABLE INITIALLY DEFERRED, "permission_id" integer NOT NULL REFERENCES "auth_permission" ("id") DEFERRABLE INITIALLY DEFERRED);
CREATE TABLE "auth_permission" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "content_type_id" integer NOT NULL REFERENCES "django_content_type" ("id") DEFERRABLE INITIALLY DEFERRED, "codename" varchar(100) NOT NULL, "name" varchar(255) NOT NULL);
